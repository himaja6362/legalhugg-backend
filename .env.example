# ============================================================================
# AI-Powered Legal Document Risk Analysis Suite — Local Environment Template
# Copy this file to `.env` in the project root:
#   cp .env.example .env      (macOS / Linux / Git Bash)
#   copy .env.example .env    (Windows Command Prompt / PowerShell)
# ============================================================================

# 1. HUGGING FACE CONFIGURATION
# - HF_INFERENCE_MODE:
#     "auto"  (default) Uses Hugging Face Inference API if HF_TOKEN is set, and automatically
#             uses built-in Local Hugging Face ONNX Transformers (Flan-T5-small, BERT-NER,
#             MobileBERT-MNLI, DistilBERT-QA) if HF_TOKEN is not set or rate-limited.
#     "api"   Requires a valid HF_TOKEN for Hugging Face Cloud Inference API.
#     "local" Runs 100% locally on CPU via @huggingface/transformers without requiring HF_TOKEN.
HF_INFERENCE_MODE=auto
HF_USE_LOCAL=true

# Optional: Hugging Face User Access Token (Create free at https://huggingface.co/settings/tokens)
# Required only when HF_INFERENCE_MODE=api or when calling cloud LLM models (Qwen/Qwen2.5-72B-Instruct)
HF_TOKEN=

# Optional: Override Hugging Face Models
HF_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_LOCAL_LLM_MODEL=Xenova/flan-t5-small
HF_NER_MODEL=Xenova/bert-base-NER
HF_NLI_MODEL=Xenova/mobilebert-uncased-mnli
HF_QA_MODEL=Xenova/distilbert-base-cased-distilled-squad

# 2. MONGODB_URI (OPTIONAL — MongoDB Atlas connection string)
# If left empty, the server automatically uses the built-in persistent local
# database store (`data_store.json`).
MONGODB_URI=

# 3. PORT (OPTIONAL — Backend server port, defaults to 3000)
PORT=3000

# 4. VITE_API_BASE_URL (OPTIONAL — Leave empty for local development)
VITE_API_BASE_URL=
